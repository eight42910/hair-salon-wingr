    height: var(--section-divider-height);
    width: var(--section-divider-width);
  }

  /* コンセプトページ専用アニメーション */
  .concept-section {
    opacity: 0;
    transform: translateY(20px);
    animation: conceptFadeIn 0.8s ease-out forwards;
  }

  .concept-section:nth-child(2) {
    animation-delay: 0.2s;
  }

  .concept-section:nth-child(3) {
    animation-delay: 0.4s;
  }

  .concept-section:nth-child(4) {
    animation-delay: 0.6s;
  }

  /* リッチなホバー効果 */
  .rich-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rich-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  /* グラデーションボーダー効果 */
  .gradient-border {
    position: relative;
    background: linear-gradient(white, white) padding-box,
      linear-gradient(45deg, var(--primary-500), var(--accent-500)) border-box;
    border: 2px solid transparent;
    border-radius: 0.5rem;
  }

  /* 背景のリッチ効果 */
  .rich-background {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(250, 247, 242, 0.9) 50%,
      rgba(255, 254, 249, 0.9) 100%
    );
    backdrop-filter: blur(10px);
  }

  /* コンセプトページ用アニメーション */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
}

@keyframes conceptFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes float-delayed {
  0%, 100% {
    transform: translateY(0px) rotate(0deg);
  }
  50% {
    transform: translateY(-15px) rotate(5deg);
  }
}

