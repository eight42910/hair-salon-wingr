  /* フレックスボックスのレスポンシブ対応 */
  .flex-responsive {
    @apply flex flex-col md:flex-row items-stretch md:items-center;
  }

  .flex-responsive-reverse {
    @apply flex flex-col-reverse md:flex-row items-stretch md:items-center;
  }

  .section-title {
    color: var(--section-title-color);
