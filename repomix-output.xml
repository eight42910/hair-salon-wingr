// 管理者（美容室）へのメール送信
export async function sendNotificationEmail(data: ContactFormData) {
  const mailOptions = {
    from: process.env.EMAIL_FROM,
    to: process.env.SALON_EMAIL,
    subject: '【WEBサイト】新しいお問い合わせ',
    html: `
      <h2>新しいお問い合わせが届きました</h2>
      
