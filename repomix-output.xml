```typescript
// React.memo によるメモ化
export const Button = React.memo<ButtonProps>(({ ... }) => {
  // 実装
});

// useMemo による計算結果キャッシュ
const memoizedStyle = useMemo(() => {
  return `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]}`;
}, [variant, size]);

