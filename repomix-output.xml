import { useState } from 'react';
import { useFormValidation } from '@/hooks/useFormValidation';
import { FormField } from './FormField';
import { FormInput } from './FormInput';
import { SectionTitle } from '@/components/ui/SectionTitle';

const bookingValidationConfig = {
  name: {
    required: true,
    minLength: 2,
    maxLength: 20,
  },
  email: {
    required: true,
    pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
  },
  phone: {
    required: true,
    pattern: /^[0-9-]+$/,
  },
  date: {
    required: true,
  },
  time: {
    required: true,
  },
  service: {
    required: true,
  },
};

export const BookingForm = () => {
  const { fields, isValid, updateField, validateAll } = useFormValidation(
    bookingValidationConfig
  );
  const [isSubmitting, setIsSubmitting] = useState(false);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!validateAll()) {
      return;
    }

    setIsSubmitting(true);
    try {
      // API送信処理
      await submitBooking(fields);
      // 成功処理
    } catch (error) {
      // エラー処理
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <div className="max-w-2xl mx-auto">
      <SectionTitle>ご予約フォーム</SectionTitle>

      <form onSubmit={handleSubmit} className="space-y-6">
        <FormField label="お名前" required error={fields.name.error}>
          <FormInput
            value={fields.name.value}
            onChange={(value) => updateField('name', value)}
            placeholder="山田太郎"
            error={fields.name.error}
          />
        </FormField>

        <FormField label="メールアドレス" required error={fields.email.error}>
          <FormInput
            type="email"
            value={fields.email.value}
            onChange={(value) => updateField('email', value)}
            placeholder="example@email.com"
            error={fields.email.error}
          />
        </FormField>

        <FormField label="電話番号" required error={fields.phone.error}>
          <FormInput
            type="tel"
            value={fields.phone.value}
            onChange={(value) => updateField('phone', value)}
            placeholder="090-1234-5678"
            error={fields.phone.error}
          />
        </FormField>

        {/* 送信ボタン */}
        <div className="pt-6">
          <button
            type="submit"
            disabled={!isValid || isSubmitting}
            className={`w-full py-3 px-4 rounded-md font-medium transition-colors ${
              isValid && !isSubmitting
                ? 'bg-primary-600 hover:bg-primary-700 text-white'
                : 'bg-gray-300 text-gray-500 cursor-not-allowed'
            }`}
          >
            {isSubmitting ? '送信中...' : '予約を確定する'}
          </button>
        </div>
      </form>
    </div>
  );
};

// API送信関数
const submitBooking = async (fields: any) => {
  const response = await fetch('/api/booking', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      name: fields.name.value,
      email: fields.email.value,
      phone: fields.phone.value,
      date: fields.date.value,
      time: fields.time.value,
      service: fields.service.value,
    }),
  });

  if (!response.ok) {
    throw new Error('送信に失敗しました');
  }

  return response.json();
};
