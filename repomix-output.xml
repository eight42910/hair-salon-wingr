  /* セクションタイトル用の変数 */
  --section-title-color: #111827;
  --section-title-font-weight: 700;
  --section-title-line-height: 1.2;
  --section-title-margin-bottom: 1rem;
  --section-divider-color: #111827;
  --section-divider-height: 2px;
  --section-divider-width: 6rem;
}

@layer components {
  .heading-1 {
    @apply text-2xl md:text-3xl lg:text-4xl font-bold text-primary-900 leading-tight;
  }
  .heading-2 {
    @apply text-xl md:text-2xl lg:text-3xl font-semibold text-primary-800 leading-tight;
  }
  .heading-3 {
    @apply text-lg md:text-xl lg:text-2xl font-medium text-primary-700 leading-tight;
  }

  .body-lg {
    @apply text-base md:text-lg text-gray-700 leading-relaxed;
  }
  .body-md {
    @apply text-sm md:text-base text-gray-600 leading-relaxed;
  }
  .body-sm {
    @apply text-xs md:text-sm text-gray-500 leading-normal;
  }

  /* レスポンシブコンテナ */
  .responsive-container {
    @apply w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }

  /* レスポンシブグリッド */
  .responsive-grid-1-2 {
    @apply grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8;
  }

  .responsive-grid-1-2-3 {
    @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8;
  }

  .responsive-grid-1-2-4 {
    @apply grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8;
  }

  /* レスポンシブセクション */
  .section-padding {
    @apply py-12 md:py-16 lg:py-20;
  }

  .section-padding-sm {
    @apply py-8 md:py-12 lg:py-16;
  }

  /* レスポンシブテキスト */
  .responsive-text-center {
    @apply text-center;
  }

  .responsive-text-left {
    @apply text-left md:text-center lg:text-left;
  }

  /* フォーム要素 */
  .form-input {
    @apply w-full px-3 py-2 md:px-4 md:py-3 border border-gray-300 rounded-md 
           focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500
           text-sm md:text-base transition-colors;
  }

  .form-label {
    @apply block text-sm md:text-base font-medium text-gray-700 mb-2;
  }

  /* ボタンのレスポンシブ対応 */
  .btn-responsive {
    @apply px-4 py-2 md:px-6 md:py-3 text-sm md:text-base;
  }

  /* カードコンポーネント */
  .card {
    @apply bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300 p-4 md:p-6;
  }

  /* 画像のレスポンシブ対応 */
  .responsive-image {
    @apply w-full h-auto object-cover rounded-lg;
  }

  /* スペーシングユーティリティ */
  .space-y-responsive {
    @apply space-y-4 md:space-y-6 lg:space-y-8;
  }

  .space-x-responsive {
    @apply space-x-2 md:space-x-4 lg:space-x-6;
  }

  /* フレックスボックスのレスポンシブ対応 */
  .flex-responsive {
    @apply flex flex-col md:flex-row items-stretch md:items-center;
  }

  .flex-responsive-reverse {
    @apply flex flex-col-reverse md:flex-row items-stretch md:items-center;
  }

  .section-title {
    color: var(--section-title-color);
    font-weight: var(--section-title-font-weight);
    line-height: var(--section-title-line-height);
    margin-bottom: var(--section-title-margin-bottom);
  }

  .section-divider {
    background-color: var(--section-divider-color);
    height: var(--section-divider-height);
    width: var(--section-divider-width);
  }

  /* コンセプトページ専用アニメーション */
  .concept-section {
    opacity: 0;
    transform: translateY(20px);
    animation: conceptFadeIn 0.8s ease-out forwards;
  }

  .concept-section:nth-child(2) {
    animation-delay: 0.2s;
  }

  .concept-section:nth-child(3) {
    animation-delay: 0.4s;
  }

  .concept-section:nth-child(4) {
    animation-delay: 0.6s;
  }

  /* リッチなホバー効果 */
  .rich-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rich-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  /* グラデーションボーダー効果 */
  .gradient-border {
    position: relative;
    background: linear-gradient(white, white) padding-box,
      linear-gradient(45deg, var(--primary-500), var(--accent-500)) border-box;
    border: 2px solid transparent;
    border-radius: 0.5rem;
  }

  /* 背景のリッチ効果 */
  .rich-background {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(250, 247, 242, 0.9) 50%,
      rgba(255, 254, 249, 0.9) 100%
    );
    backdrop-filter: blur(10px);
  }

  /* コンセプトページ用アニメーション */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
}

@keyframes conceptFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* スクロール連動アニメーション（将来実装） */
@media (prefers-reduced-motion: no-preference) {
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .scroll-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
}

/* カスタムブレークポイント */
@media (max-width: 479px) {
  .heading-1 {
    font-size: 1.5rem;
  }

  .heading-2 {
    font-size: 1.25rem;
  }

  .section-padding {
    @apply py-8;
  }
}

/* タブレット専用調整 */
@media (min-width: 768px) and (max-width: 999px) {
  .tablet-hide {
    display: none;
  }

  .tablet-show {
    display: block;
  }

  /* タブレットでのグリッド調整 */
  .tablet-grid-1 {
    grid-template-columns: 1fr;
  }

  .tablet-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* デスクトップ専用 */
@media (min-width: 1000px) {
  .desktop-show {
    display: block;
  }

  .desktop-hide {
    display: none;
  }
}

/* 高解像度対応 */
@media (min-width: 1400px) {
  .container {
    max-width: 1320px;
  }
}

/* アクセシビリティ対応 */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ダークモード対応（将来的な拡張のため） */
@media (prefers-color-scheme: dark) {
  :root {
    /* ダークモード用の色定義（将来実装時） */
  }
}

/* プリント用スタイル */
@media print {
  .print-hide {
    display: none !important;
  }

  body {
    background: white !important;
    color: black !important;
  }
}
