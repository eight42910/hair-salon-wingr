    @apply py-8 md:py-12 lg:py-16;
  }

  /* レスポンシブテキスト */
  .responsive-text-center {
    @apply text-center;
  }

  .responsive-text-left {
    @apply text-left md:text-center lg:text-left;
  }

  /* フォーム要素 */
  .form-input {
    @apply w-full px-3 py-2 md:px-4 md:py-3 border border-gray-300 rounded-md 
           focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500
