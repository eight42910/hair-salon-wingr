            </button>
          </div>

          {/* ナビゲーション */}
          <div className="flex-1 overflow-y-auto py-4">
            <nav className="px-4 space-y-2">
              {navigation.map((item) => (
                <Link
                  key={item.name}
                  href={item.href}
                  className="flex items-center py-3 px-4 text-gray-700 hover:bg-primary-50 hover:text-primary-900 rounded-lg transition-colors group"
