  --accent-400: #ffe8b8;
  --accent-500: #f5e6d3;
  --accent-600: #ead7be;
  --accent-700: #dfc7a6;
  --accent-800: #d4b88e;
  --accent-900: #c9a876;

  /* セクションタイトル用の変数 */
  --section-title-color: #111827;
  --section-title-font-weight: 700;
  --section-title-line-height: 1.2;
  --section-title-margin-bottom: 1rem;
  --section-divider-color: #111827;
  --section-divider-height: 2px;
  --section-divider-width: 6rem;
}

@layer components {
  .heading-1 {
    @apply text-2xl md:text-3xl lg:text-4xl font-bold text-primary-900 leading-tight;
  }
  .heading-2 {
    @apply text-xl md:text-2xl lg:text-3xl font-semibold text-primary-800 leading-tight;
  }
  .heading-3 {
    @apply text-lg md:text-xl lg:text-2xl font-medium text-primary-700 leading-tight;
  }

  .body-lg {
    @apply text-base md:text-lg text-gray-700 leading-relaxed;
  }
  .body-md {
    @apply text-sm md:text-base text-gray-600 leading-relaxed;
  }
  .body-sm {
    @apply text-xs md:text-sm text-gray-500 leading-normal;
  }

  /* レスポンシブコンテナ */
  .responsive-container {
    @apply w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }

  /* レスポンシブグリッド */
  .responsive-grid-1-2 {
    @apply grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8;
  }

  .responsive-grid-1-2-3 {
    @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8;
  }

  .responsive-grid-1-2-4 {
    @apply grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8;
  }

  /* レスポンシブセクション */
  .section-padding {
    @apply py-12 md:py-16 lg:py-20;
