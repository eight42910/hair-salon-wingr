  /* グラデーションボーダー効果 */
  .gradient-border {
    position: relative;
    background: linear-gradient(white, white) padding-box,
      linear-gradient(45deg, var(--primary-500), var(--accent-500)) border-box;
    border: 2px solid transparent;
    border-radius: 0.5rem;
  }

  /* 背景のリッチ効果 */
  .rich-background {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(250, 247, 242, 0.9) 50%,
      rgba(255, 254, 249, 0.9) 100%
    );
    backdrop-filter: blur(10px);
  }

  /* コンセプトページ用アニメーション */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  /* 美容室ブランド専用グラデーション */
  .salon-gradient-primary {
    @apply bg-gradient-to-br from-primary-100 to-accent-100;
  }

  .salon-gradient-secondary {
    @apply bg-gradient-to-br from-secondary-100 to-primary-100;
  }

  .salon-gradient-accent {
    @apply bg-gradient-to-br from-accent-100 to-secondary-100;
  }

  .salon-gradient-hover-primary {
    @apply bg-gradient-to-br from-primary-200/30 to-accent-200/30;
  }

  .salon-gradient-hover-secondary {
    @apply bg-gradient-to-br from-secondary-200/30 to-primary-200/30;
  }

  /* アイコン用グラデーション */
  .salon-icon-gradient {
    @apply bg-gradient-to-br from-primary-400 to-primary-500;
  }

  .salon-icon-gradient-accent {
    @apply bg-gradient-to-br from-accent-400 to-accent-500;
  }

  /* 装飾的な背景要素 */
  .salon-decoration-circle {
    @apply bg-gradient-to-br from-primary-100/20 to-accent-100/20 rounded-full;
  }

  .salon-decoration-circle-hover {
    @apply group-hover:from-primary-200/30 group-hover:to-accent-200/30 transition-all duration-300;
  }
}

@keyframes conceptFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
